function %fib(i64) -> i64 {
block0(v0: i64):
    v1 = iconst.i64 0
    v2 = iconst.i64 1
    jump block1(v0, v1, v2)

block1(v3: i64, v4: i64, v5: i64):
    brif v3, block2, block3

block2:
    v6 = iadd v4, v5
    v7 = iconst.i64 1
    v8 = isub v3, v7
    jump block1(v8, v5, v6)

block3:
    return v4
}
